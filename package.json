{
  "name": "floorplan-3d-card",
  "version": "0.3.1",
  "description": "Interactive 3D floorplan card for Home Assistant — cross-sections, camera presets, drag & drop entity placement and physically driven lighting.",
  "type": "module",
  "license": "GPL-3.0-or-later",
  "homepage": "https://github.com/PetePete/floorplanhs#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PetePete/floorplanhs.git"
  },
  "bugs": {
    "url": "https://github.com/PetePete/floorplanhs/issues"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:fast": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "lit": "^3.2.1",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/three": "^0.170.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
